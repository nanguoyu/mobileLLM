{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilellm.local/schemas/agent-harness/scripted-model.v1.schema.json",
  "title": "Deterministic scripted model fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "scriptID", "name", "seed", "provider", "model", "scenario",
    "steps", "expected"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "scriptID": { "type": "string", "pattern": "^AH-FIXTURE-MODEL-[A-Z0-9]+(?:-[A-Z0-9]+)+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "seed": { "type": "integer", "minimum": 0 },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "protocolVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "const": "scriptedLocal" },
        "protocolVersion": { "const": "1.0.0" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "variantID", "capabilityRevision", "contextLimit", "outputLimit"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "variantID": { "type": "string", "minLength": 1, "maxLength": 100 },
        "capabilityRevision": { "type": "string", "minLength": 1, "maxLength": 100 },
        "contextLimit": { "type": "integer", "minimum": 1 },
        "outputLimit": { "type": "integer", "minimum": 1 }
      }
    },
    "scenario": { "enum": ["pureChat", "toolThenAnswer", "malformedRepair", "userInput"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "expected": { "$ref": "#/$defs/expected" }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "kind"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["modelAttempt", "toolOutcome", "userResponse"] },
        "assertRequest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "advertisedToolLogicalIDs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "mustContain": { "type": "array", "items": { "type": "string" } },
            "mustNotContain": { "type": "array", "items": { "type": "string" } },
            "thinkingEnabled": { "type": "boolean" },
            "maximumOutputTokens": { "type": "integer", "minimum": 1 }
          }
        },
        "emissions": {
          "type": "array",
          "items": { "$ref": "#/$defs/emission" }
        },
        "toolOutcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["invocationID", "toolLogicalID", "resultJSON", "effectsConfirmed"],
          "properties": {
            "invocationID": { "type": "string", "format": "uuid" },
            "toolLogicalID": { "type": "string", "minLength": 1 },
            "resultJSON": {},
            "effectsConfirmed": { "type": "boolean" }
          }
        },
        "userResponse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestID", "valueJSON"],
          "properties": {
            "requestID": { "type": "string", "format": "uuid" },
            "valueJSON": {}
          }
        }
      }
    },
    "emission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["reasoningDelta", "answerDelta", "toolCalls", "malformedAction", "requestUserInput", "usage", "completed", "failed"]
        },
        "text": { "type": "string" },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["invocationID", "toolLogicalID", "argumentsJSON"],
            "properties": {
              "invocationID": { "type": "string", "format": "uuid" },
              "toolLogicalID": { "type": "string", "minLength": 1 },
              "argumentsJSON": {}
            }
          }
        },
        "requestID": { "type": "string", "format": "uuid" },
        "prompt": { "type": "string" },
        "responseSchemaJSON": {},
        "promptTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "failureCode": { "type": "string" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelAttempts", "toolInvocations", "structuredRepairs", "interactionRequests",
        "terminalState", "finalAnswer", "forbiddenActions"
      ],
      "properties": {
        "modelAttempts": { "type": "integer", "minimum": 0 },
        "toolInvocations": { "type": "integer", "minimum": 0 },
        "structuredRepairs": { "type": "integer", "minimum": 0 },
        "interactionRequests": { "type": "integer", "minimum": 0 },
        "terminalState": { "enum": ["completed", "failed", "cancelled"] },
        "finalAnswer": { "type": ["string", "null"] },
        "forbiddenActions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
