{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilellm.local/schemas/agent-harness/semantic-registry.v1.schema.json",
  "title": "mobileLLM Agent Harness semantic registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentID",
    "registryType",
    "completeness",
    "sourceSpecification",
    "entries"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "registryVersion": { "const": 1 },
    "documentID": {
      "type": "string",
      "pattern": "^AH-REGISTRY-[A-Z0-9]+(?:-[A-Z0-9]+)*-V1$"
    },
    "registryType": {
      "enum": [
        "run-states",
        "run-transitions",
        "approval-decisions",
        "stable-boundary-faults"
      ]
    },
    "completeness": { "enum": ["complete", "initial"] },
    "sourceSpecification": { "$ref": "#/$defs/sourceSpecification" },
    "evaluationSemantics": { "$ref": "#/$defs/evaluationSemantics" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finiteDomain" }
    },
    "enumerationEvidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/enumerationEvidence" }
    },
    "effectNormalization": { "$ref": "#/$defs/effectNormalization" },
    "requirementIDs": { "$ref": "#/$defs/traceability/properties/requirementIDs" },
    "testIDs": { "$ref": "#/$defs/traceability/properties/testIDs" },
    "entries": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "registryType": { "const": "run-states" } } },
      "then": {
        "properties": {
          "completeness": { "const": "complete" },
          "entries": {
            "minItems": 16,
            "maxItems": 16,
            "items": { "$ref": "#/$defs/runState" }
          }
        }
      }
    },
    {
      "if": { "properties": { "registryType": { "const": "run-transitions" } } },
      "then": {
        "required": [
          "registryVersion",
          "evaluationSemantics",
          "domains",
          "enumerationEvidence",
          "requirementIDs",
          "testIDs"
        ],
        "properties": {
          "completeness": { "const": "complete" },
          "entries": { "items": { "$ref": "#/$defs/runTransitionRule" } }
        }
      }
    },
    {
      "if": { "properties": { "registryType": { "const": "approval-decisions" } } },
      "then": {
        "required": [
          "registryVersion",
          "evaluationSemantics",
          "domains",
          "enumerationEvidence",
          "effectNormalization",
          "requirementIDs",
          "testIDs"
        ],
        "properties": {
          "completeness": { "const": "complete" },
          "entries": { "items": { "$ref": "#/$defs/approvalDecisionRule" } }
        }
      }
    },
    {
      "if": { "properties": { "registryType": { "const": "stable-boundary-faults" } } },
      "then": {
        "properties": {
          "completeness": { "const": "complete" },
          "entries": {
            "minItems": 20,
            "maxItems": 20,
            "items": { "$ref": "#/$defs/faultPoint" }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^AH-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "testIdentifier": {
      "type": "string",
      "pattern": "^AHT-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "sourceSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "section", "lineStart", "lineEnd"],
      "properties": {
        "path": { "const": "spec.md" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "section": { "type": "string", "minLength": 1 },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementIDs", "testIDs"],
      "properties": {
        "requirementIDs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "testIDs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/testIdentifier" }
        }
      }
    },
    "evaluationSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "precedence",
        "noMatch",
        "equalPriorityConflict",
        "unknownDomainValue",
        "deadRule"
      ],
      "properties": {
        "version": { "const": 1 },
        "precedence": { "const": "higherPriorityWins" },
        "noMatch": { "const": "denyAndEmitDiagnostic" },
        "equalPriorityConflict": { "const": "registryInvalid" },
        "unknownDomainValue": { "const": "denyAndEmitDiagnostic" },
        "deadRule": { "const": "registryInvalid" }
      }
    },
    "finiteDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "name", "values"],
      "properties": {
        "table": { "$ref": "#/$defs/tableName" },
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "enumerationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "cellCount", "ruleCount", "winningRuleCount"],
      "properties": {
        "table": { "$ref": "#/$defs/tableName" },
        "cellCount": { "type": "integer", "minimum": 1 },
        "ruleCount": { "type": "integer", "minimum": 1 },
        "winningRuleCount": { "type": "integer", "minimum": 1 }
      }
    },
    "conditionMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "runTransitionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "table", "priority", "conditions", "outcome", "requirementIDs", "testIDs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "table": {
          "enum": [
            "commandAdmission", "pauseCancelRouting", "resumeRouting", "approvalCommandRouting",
            "responseCommandRouting", "reconciliationCommandRouting", "trustedProgressRouting",
            "quiescenceRouting", "terminalFailureRouting"
          ]
        },
        "priority": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "conditions": { "$ref": "#/$defs/conditionMap" },
        "outcome": { "$ref": "#/$defs/runTransitionOutcome" },
        "requirementIDs": { "$ref": "#/$defs/traceability/properties/requirementIDs" },
        "testIDs": { "$ref": "#/$defs/traceability/properties/testIDs" }
      }
    },
    "runTransitionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "nextState", "terminalReason", "diagnostic"],
      "properties": {
        "disposition": {
          "enum": ["proceed", "accepted", "replayOriginalReceipt", "stale", "rejected"]
        },
        "nextState": {
          "oneOf": [{ "$ref": "#/$defs/runStateName" }, { "type": "null" }]
        },
        "terminalReason": {
          "oneOf": [{ "$ref": "#/$defs/terminalReason" }, { "type": "null" }]
        },
        "diagnostic": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$", "maxLength": 100 },
            { "type": "null" }
          ]
        }
      }
    },
    "approvalDecisionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "table", "priority", "conditions", "outcome", "requirementIDs", "testIDs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "table": {
          "enum": ["authorization", "approvalPresentation", "systemAccess", "retryAndTransportLoss"]
        },
        "priority": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "conditions": { "$ref": "#/$defs/conditionMap" },
        "outcome": { "$ref": "#/$defs/approvalOutcome" },
        "requirementIDs": { "$ref": "#/$defs/traceability/properties/requirementIDs" },
        "testIDs": { "$ref": "#/$defs/traceability/properties/testIDs" }
      }
    },
    "approvalOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision", "grantScope", "retryDirective", "uncertainOnTransportLoss", "runState", "diagnostic"
      ],
      "properties": {
        "decision": {
          "enum": [
            "authorizeLocalPolicy", "authorizeMatchingReceipt", "requireApproval", "deny",
            "presentApproval", "deferApproval", "noPresentation", "continue",
            "requestSystemPrompt", "waitForForeground", "complete", "retrySameOperation",
            "failKnownNoEffect", "waitForReconciliation"
          ]
        },
        "grantScope": { "enum": ["none", "exactInvocation", "boundedConversationRead"] },
        "retryDirective": { "enum": ["none", "boundedExponential"] },
        "uncertainOnTransportLoss": { "type": "boolean" },
        "runState": {
          "oneOf": [{ "$ref": "#/$defs/runStateName" }, { "type": "null" }]
        },
        "diagnostic": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$", "maxLength": 100 },
            { "type": "null" }
          ]
        }
      }
    },
    "effectNormalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputSemantics", "outputSemantics", "classes"],
      "properties": {
        "inputSemantics": { "const": "setOfTrustedObservedEffects" },
        "outputSemantics": { "const": "highestRiskWins" },
        "classes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/effectNormalizationClass" }
        }
      }
    },
    "effectNormalizationClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "effectClass", "sourceEffects"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 8 },
        "effectClass": { "$ref": "#/$defs/effectClass" },
        "sourceEffects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "runState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "terminal", "resumable", "ownsExecutionSlot", "allowedUserCommands",
        "requirementIDs", "testIDs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/runStateName" },
        "terminal": { "type": "boolean" },
        "resumable": { "type": "boolean" },
        "ownsExecutionSlot": { "type": "boolean" },
        "allowedUserCommands": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/commandName" }
        },
        "requirementIDs": { "$ref": "#/$defs/traceability/properties/requirementIDs" },
        "testIDs": { "$ref": "#/$defs/traceability/properties/testIDs" }
      }
    },
    "faultPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "boundaryOrdinal", "boundary", "phase", "injectedFailure", "expectedRecovery",
        "requirementIDs", "testIDs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "boundaryOrdinal": { "type": "integer", "minimum": 1, "maximum": 10 },
        "boundary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phase": { "enum": ["before", "after"] },
        "injectedFailure": {
          "enum": ["processTermination", "writeFailure", "transactionRollback"]
        },
        "expectedRecovery": { "type": "string", "minLength": 1, "maxLength": 500 },
        "requirementIDs": { "$ref": "#/$defs/traceability/properties/requirementIDs" },
        "testIDs": { "$ref": "#/$defs/traceability/properties/testIDs" }
      }
    },
    "tableName": {
      "enum": [
        "commandAdmission", "pauseCancelRouting", "resumeRouting", "approvalCommandRouting",
        "responseCommandRouting", "reconciliationCommandRouting", "trustedProgressRouting",
        "quiescenceRouting", "terminalFailureRouting", "authorization", "approvalPresentation",
        "systemAccess", "retryAndTransportLoss"
      ]
    },
    "runStateName": {
      "enum": [
        "created", "preparing", "waitingForModel", "generating", "validatingAction",
        "waitingForApproval", "executingTools", "waitingForUser", "synthesizing", "pausing",
        "paused", "waitingForForeground", "waitingForReconciliation", "completed", "failed",
        "cancelled"
      ]
    },
    "commandName": {
      "enum": ["pause", "resume", "cancel", "decideApproval", "reconcile", "respond"]
    },
    "terminalReason": {
      "enum": [
        "completed", "cancelledByUser", "budgetExceeded", "noProgress", "permissionDenied",
        "toolUnavailable", "modelUnavailable", "contextUnsatisfiable", "externalResultUncertain",
        "internalFailure"
      ]
    },
    "effectClass": {
      "enum": [
        "localPure", "appLocalRead", "appLocalWrite", "externalRead", "externalWrite",
        "strongExact", "codeExecution", "unknownExternal"
      ]
    }
  }
}
