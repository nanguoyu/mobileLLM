{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilellm.local/schemas/agent-harness/app-container.v1.schema.json",
  "title": "Deterministic Agent Harness app-container fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "fixtureID", "scenario", "isolationNamespace", "initialState",
    "provisioning", "expectedLaunchState", "requiredAssertions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "fixtureID": { "type": "string", "pattern": "^AH-FIXTURE-CONTAINER-[A-Z0-9]+(?:-[A-Z0-9]+)+$" },
    "scenario": { "enum": ["cleanInstall", "legacyUpgrade"] },
    "isolationNamespace": { "type": "string", "minLength": 1, "maxLength": 120 },
    "initialState": { "type": "object" },
    "provisioning": { "type": "object" },
    "expectedLaunchState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedConversationID", "loadedModelID", "resumedRunIDs", "externalOperations"],
      "properties": {
        "selectedConversationID": { "type": "null" },
        "loadedModelID": { "type": "null" },
        "resumedRunIDs": { "type": "array", "maxItems": 0 },
        "externalOperations": { "type": "array", "maxItems": 0 }
      }
    },
    "requiredAssertions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
